# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OpenShorts processing engine configuration (server-side only)
OPENSHORTS_API_URL="https://api.openshorts.ai"
OPENSHORTS_API_KEY="your-openshorts-api-key"
OPENSHORTS_WEBHOOK_SECRET="your-openshorts-webhook-secret"
