# GEMINI_API_KEY: Required for Gemini AI moment scoring / discovery grounding.
GEMINI_API_KEY="your_gemini_api_key_here"

# GitHub Actions Ephemeral Runner Worker Configuration
GITHUB_TOKEN="your_github_personal_access_token_or_actions_token"
GITHUB_REPOSITORY="your-github-username/your-repository-name"
GITHUB_WORKFLOW_FILE="process-video.yml"

# Piped Stream Resolver Instances
PIPED_INSTANCES="https://pipedapi.kavin.rocks,https://pipedapi.in.projectsegfau.lt,https://pipedapi.privacy.com.de"

# Firebase Client Configuration
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
